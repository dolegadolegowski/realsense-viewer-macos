diff --git a/src/libusb/broker/broker-connection.cpp b/src/libusb/broker/broker-connection.cpp
new file mode 100644
index 000000000..94d7b1808
--- /dev/null
+++ b/src/libusb/broker/broker-connection.cpp
@@ -0,0 +1,454 @@
+// License: Apache 2.0. See LICENSE file in root directory.
+// Copyright(c) 2026 RealSense, Inc. All Rights Reserved.
+
+#include "broker-connection.h"
+#include "device-broker.h"
+#include "request-broker.h"
+#include "../interface-libusb.h"
+#include "../handle-libusb.h"
+
+#include <rsutils/easylogging/easyloggingpp.h>
+
+#include <algorithm>
+#include <atomic>
+#include <thread>
+
+namespace librealsense
+{
+    namespace platform
+    {
+        using steady = std::chrono::steady_clock;
+
+        static xpc_endpoint_t test_endpoint = nullptr;
+        static std::atomic< uint32_t > hide_ms{ RSUSB_LOSS_HIDE_MS };
+
+        namespace
+        {
+            struct call_state
+            {
+                dispatch_semaphore_t done = dispatch_semaphore_create( 0 );
+                xpc_ptr reply;
+                ~call_state() { dispatch_release( done ); }
+            };
+
+            std::shared_ptr< call_state > send_with_reply( xpc_connection_t conn, xpc_object_t msg )
+            {
+                auto state = std::make_shared< call_state >();
+                xpc_connection_send_message_with_reply( conn, msg, dispatch_get_global_queue( QOS_CLASS_USER_INITIATED, 0 ),
+                                                        ^( xpc_object_t reply ) {
+                                                            state->reply = xpc_ptr::retain( reply );
+                                                            dispatch_semaphore_signal( state->done );
+                                                        } );
+                return state;
+            }
+
+            bool wait( const std::shared_ptr< call_state > & state, steady::time_point deadline )
+            {
+                auto ns = std::chrono::duration_cast< std::chrono::nanoseconds >( deadline - steady::now() ).count();
+                return dispatch_semaphore_wait( state->done, dispatch_time( DISPATCH_TIME_NOW, ns > 0 ? ns : 0 ) ) == 0;
+            }
+        }
+
+        xpc_ptr broker_message( uint64_t op )
+        {
+            auto msg = xpc_ptr::adopt( xpc_dictionary_create( nullptr, nullptr, 0 ) );
+            xpc_dictionary_set_uint64( msg.get(), RSUSB_KEY_OP, op );
+            return msg;
+        }
+
+        usb_status broker_status_to_rs( const broker_reply & reply )
+        {
+            switch( reply.result )
+            {
+            case broker_reply::ok:
+                return reply.status < INT32_MIN || reply.status > INT32_MAX ? RS2_USB_STATUS_OTHER
+                                                                            : libusb_status_to_rs( int( reply.status ) );
+            case broker_reply::timeout: return RS2_USB_STATUS_TIMEOUT;
+            case broker_reply::invalid: return RS2_USB_STATUS_OTHER;
+            default: return RS2_USB_STATUS_NO_DEVICE;
+            }
+        }
+
+        void usb_broker::use_endpoint_for_testing( xpc_endpoint_t endpoint )
+        {
+            test_endpoint = static_cast< xpc_endpoint_t >( xpc_retain( endpoint ) );
+        }
+
+        void usb_broker::hide_ms_for_testing( uint32_t ms )
+        {
+            hide_ms = ms;
+        }
+
+        std::shared_ptr< usb_broker > usb_broker::instance()
+        {
+            static std::once_flag once;
+            static std::shared_ptr< usb_broker > broker;
+            std::call_once( once, []() {
+                auto b = std::make_shared< usb_broker >();
+                auto conn = b->connect();
+                std::string reason;
+                if( b->hello( conn.connection(), reason ) != hello_ok )
+                {
+                    // the destructor cancels the connection
+                    LOG_INFO( "RealSense USB broker not used (" << reason << "), accessing USB devices in-process" );
+                    return;
+                }
+                std::unique_lock< std::shared_timed_mutex > lock( b->_session_mutex );
+                b->_generation = 1;
+                b->_up = true;
+                b->_routes = std::make_shared< broker_route_table >();
+                broker = b;
+            } );
+            return broker;
+        }
+
+        usb_broker::usb_broker()
+            : _queue( dispatch_queue_create( "librealsense.usb-broker.connection", DISPATCH_QUEUE_SERIAL ) )
+        {
+        }
+
+        usb_broker::~usb_broker()
+        {
+            if( _conn && ! _conn_invalid )
+                xpc_connection_cancel( _conn.connection() );
+            dispatch_release( _queue );
+        }
+
+        xpc_ptr usb_broker::connect()
+        {
+            auto conn = xpc_ptr::adopt( test_endpoint
+                ? xpc_connection_create_from_endpoint( test_endpoint )
+                : xpc_connection_create_mach_service( RSUSB_SERVICE_NAME, _queue, XPC_CONNECTION_MACH_SERVICE_PRIVILEGED ) );
+            xpc_connection_set_target_queue( conn.connection(), _queue );
+            std::unique_lock< std::shared_timed_mutex > lock( _session_mutex );
+            uint64_t id = ++_conn_id;
+            std::weak_ptr< usb_broker > weak = shared_from_this();
+            xpc_connection_set_event_handler( conn.connection(), ^( xpc_object_t event ) {
+                if( auto self = weak.lock() )
+                    self->on_event( id, event );
+            } );
+            xpc_connection_resume( conn.connection() );
+            _conn = conn;
+            _conn_invalid = false;
+            _conn_created = steady::now();
+            return conn;
+        }
+
+        usb_broker::hello_result usb_broker::hello( xpc_connection_t conn, std::string & reason )
+        {
+            auto deadline = steady::now() + std::chrono::milliseconds( RSUSB_HELLO_TIMEOUT_MS );
+            reason = "not reachable: the camera service is not installed, switched off, or does not admit this program";
+            auto msg = broker_message( RSUSB_OP_HELLO );
+            xpc_dictionary_set_uint64( msg.get(), RSUSB_KEY_VERSION, RSUSB_PROTOCOL_VERSION );
+            // An interrupted connection (daemon idle-exiting or relaunching) is retried; invalid is final
+            for( int retries = 3; ; --retries )
+            {
+                auto state = send_with_reply( conn, msg.get() );
+                if( ! wait( state, deadline ) )
+                    return hello_unreachable;
+                xpc_object_t r = state->reply.get();
+                if( r == XPC_ERROR_CONNECTION_INTERRUPTED && retries > 0 && steady::now() < deadline )
+                {
+                    std::this_thread::sleep_for( std::chrono::milliseconds( 100 ) );
+                    continue;
+                }
+                int64_t st;
+                uint64_t pv, auth;
+                std::string build;
+                if( ! xpc_get_i64( r, RSUSB_KEY_STATUS, st ) || st != RSUSB_ST_SUCCESS
+                    || ! xpc_get_u64( r, RSUSB_KEY_VERSION, pv ) || ! xpc_get_u64( r, RSUSB_KEY_AUTH, auth )
+                    || ! xpc_get_string( r, RSUSB_KEY_BUILD, build ) || build.size() > RSUSB_MAX_BUILD_LEN )
+                    return hello_unreachable;
+                switch( auth )
+                {
+                case RSUSB_AUTH_OK:
+                    if( pv == RSUSB_PROTOCOL_VERSION )
+                    {
+                        LOG_INFO( "Using RealSense USB broker " << build );
+                        return hello_ok;
+                    }
+                    reason = "protocol version";
+                    break;
+                case RSUSB_AUTH_USER: reason = "not the console user"; break;
+                case RSUSB_AUTH_CAMERA_DISABLED: reason = "camera disabled by policy"; break;
+                case RSUSB_AUTH_VERSION: reason = "protocol version"; break;
+                case RSUSB_AUTH_LIMIT: reason = "too many clients"; break;
+                default: return hello_unreachable;
+                }
+                return hello_rejected;
+            }
+        }
+
+        uint64_t usb_broker::ensure_session()
+        {
+            std::lock_guard< std::mutex > connecting( _connect_mutex );
+            xpc_ptr conn;
+            {
+                std::shared_lock< std::shared_timed_mutex > lock( _session_mutex );
+                if( _up )
+                    return _generation;
+                if( ! _conn_invalid )
+                    conn = _conn;
+                else if( steady::now() - _conn_created < std::chrono::seconds( 1 ) )
+                    return 0;
+            }
+            if( ! conn )
+                conn = connect();
+            std::string reason;
+            auto result = hello( conn.connection(), reason );
+            std::unique_lock< std::shared_timed_mutex > lock( _session_mutex );
+            if( result != hello_ok )
+            {
+                LOG_DEBUG( "RealSense USB broker session not restored: " << reason );
+                xpc_connection_cancel( conn.connection() );
+                _conn_invalid = true;
+                return 0;
+            }
+            _up = true;
+            _routes = std::make_shared< broker_route_table >();
+            return ++_generation;
+        }
+
+        void usb_broker::end_session( uint64_t generation, bool cancel )
+        {
+            std::shared_ptr< broker_route_table > routes;
+            {
+                std::unique_lock< std::shared_timed_mutex > lock( _session_mutex );
+                if( ! _up || generation != _generation )
+                    return;
+                _up = false;
+                ++_generation;
+                routes.swap( _routes );
+                if( cancel )
+                {
+                    xpc_connection_cancel( _conn.connection() );
+                    _conn_invalid = true;
+                }
+            }
+            LOG_WARNING( "RealSense USB broker session lost" );
+            {
+                std::lock_guard< std::mutex > lock( _state_mutex );
+                _hide_all_until = steady::now() + std::chrono::milliseconds( hide_ms );
+                for( auto & weak : _devices )
+                    if( auto dev = weak.lock() )
+                        dev->set_dead();
+            }
+            // Every request still in flight completes with NO_DEVICE through its device's callback queue
+            std::lock_guard< std::mutex > lock( routes->mutex );
+            for( auto & route : routes->routes )
+            {
+                uint64_t r = route.first;
+                dispatch_async( route.second->callback_queue(), ^{
+                    usb_request_broker::deliver( routes, r, RSUSB_XS_NO_DEVICE, 0 );
+                } );
+            }
+        }
+
+        void usb_broker::on_event( uint64_t conn_id, xpc_object_t event )
+        {
+            if( xpc_get_type( event ) == XPC_TYPE_ERROR )
+            {
+                uint64_t generation;
+                {
+                    std::unique_lock< std::shared_timed_mutex > lock( _session_mutex );
+                    if( conn_id != _conn_id )
+                        return;
+                    if( event == XPC_ERROR_CONNECTION_INVALID )
+                        _conn_invalid = true;
+                    generation = _generation;
+                }
+                end_session( generation, false );
+                return;
+            }
+
+            uint64_t ev, generation;
+            std::shared_ptr< broker_route_table > routes;
+            {
+                std::shared_lock< std::shared_timed_mutex > lock( _session_mutex );
+                if( conn_id != _conn_id || ! _up )
+                    return;
+                generation = _generation;
+                routes = _routes;
+            }
+            if( ! xpc_get_u64( event, RSUSB_KEY_EVENT, ev ) )
+                return;
+            if( ev == RSUSB_EV_REQ_DONE )
+            {
+                uint64_t r, xs, n;
+                if( ! xpc_get_u64( event, RSUSB_KEY_REQUEST_ID, r ) || ! xpc_get_u64( event, RSUSB_KEY_TRANSFER_STATUS, xs )
+                    || ! xpc_get_u64( event, RSUSB_KEY_TRANSFERRED, n ) )
+                    return;
+                std::lock_guard< std::mutex > lock( routes->mutex );
+                auto it = routes->routes.find( r );
+                if( it != routes->routes.end() )
+                    dispatch_async( it->second->callback_queue(), ^{
+                        usb_request_broker::deliver( routes, r, xs, n );
+                    } );
+            }
+            else if( ev == RSUSB_EV_DEVICE_GONE )
+            {
+                uint64_t tok;
+                if( xpc_get_u64( event, RSUSB_KEY_TOKEN, tok ) )
+                    device_lost( generation, tok );
+            }
+        }
+
+        bool usb_broker::is_current( uint64_t generation ) const
+        {
+            std::shared_lock< std::shared_timed_mutex > lock( _session_mutex );
+            return _up && generation == _generation;
+        }
+
+        std::shared_ptr< broker_route_table > usb_broker::routes( uint64_t generation ) const
+        {
+            std::shared_lock< std::shared_timed_mutex > lock( _session_mutex );
+            return _up && generation == _generation ? _routes : nullptr;
+        }
+
+        broker_reply usb_broker::call( uint64_t generation, xpc_object_t msg, uint32_t timeout_ms, bool end_on_timeout )
+        {
+            std::shared_ptr< call_state > state;
+            {
+                std::shared_lock< std::shared_timed_mutex > lock( _session_mutex );
+                if( ! _up || generation != _generation )
+                    return { broker_reply::failed, {}, 0 };
+                state = send_with_reply( _conn.connection(), msg );
+            }
+            if( ! wait( state, steady::now() + std::chrono::milliseconds( timeout_ms ) ) )
+            {
+                if( end_on_timeout )
+                    end_session( generation, true );
+                return { broker_reply::timeout, {}, 0 };
+            }
+            if( xpc_get_type( state->reply.get() ) == XPC_TYPE_ERROR )
+                return { broker_reply::failed, {}, 0 };
+            int64_t st;
+            if( ! xpc_get_i64( state->reply.get(), RSUSB_KEY_STATUS, st ) )
+                return { broker_reply::invalid, {}, 0 };
+            return { broker_reply::ok, state->reply, st };
+        }
+
+        void usb_broker::send( uint64_t generation, xpc_object_t msg, bool with_reply )
+        {
+            std::shared_lock< std::shared_timed_mutex > lock( _session_mutex );
+            if( ! _up || generation != _generation )
+                return;
+            if( with_reply )
+                xpc_connection_send_message_with_reply( _conn.connection(), msg, dispatch_get_global_queue( QOS_CLASS_UTILITY, 0 ),
+                                                        ^( xpc_object_t ) {} );
+            else
+                xpc_connection_send_message( _conn.connection(), msg );
+        }
+
+        void usb_broker::device_lost( uint64_t generation, uint64_t token )
+        {
+            if( ! is_current( generation ) )
+                return;
+            std::lock_guard< std::mutex > lock( _state_mutex );
+            for( auto & weak : _devices )
+            {
+                auto dev = weak.lock();
+                if( dev && dev->get_generation() == generation && dev->get_token() == token )
+                {
+                    dev->set_dead();
+                    _hidden[dev->get_path()] = steady::now() + std::chrono::milliseconds( hide_ms );
+                }
+            }
+        }
+
+        bool usb_broker::is_hidden( const std::string & path )
+        {
+            std::lock_guard< std::mutex > lock( _state_mutex );
+            auto it = _hidden.find( path );
+            if( it == _hidden.end() )
+                return false;
+            if( steady::now() < it->second )
+                return true;
+            _hidden.erase( it );
+            return false;
+        }
+
+        bool usb_broker::enumerate( uint64_t generation, std::vector< broker_device_snapshot > & devices )
+        {
+            auto reply = call( generation, broker_message( RSUSB_OP_ENUMERATE ).get(), RSUSB_CALL_TIMEOUT_MS, false );
+            if( reply.result != broker_reply::ok || reply.status != RSUSB_ST_SUCCESS )
+                return false;
+            if( parse_enumerate_reply( reply.msg.get(), devices ) )
+                return true;
+            LOG_WARNING( "invalid device list from the RealSense USB broker" );
+            return false;
+        }
+
+        std::vector< usb_device_info > usb_broker::query_devices_info()
+        {
+            std::vector< usb_device_info > rv;
+            std::vector< broker_device_snapshot > devices;
+            auto generation = ensure_session();
+            if( ! generation )
+                return rv;
+            {
+                std::lock_guard< std::mutex > lock( _state_mutex );
+                if( steady::now() < _hide_all_until )
+                    return rv;
+            }
+            if( ! enumerate( generation, devices ) )
+                return rv;
+            for( auto & dev : devices )
+            {
+                if( is_hidden( dev.path ) )
+                    continue;
+                auto & dd = dev.device_desc;
+                for( size_t i = 0; i < dev.interfaces.size(); ++i )
+                {
+                    auto & intf = dev.interfaces[i];
+                    auto & alt = intf.alts[0].desc;
+                    uint16_t mi = 0;   // index within its configuration
+                    for( size_t j = i; j > 0 && dev.interfaces[j - 1].config == intf.config; --j )
+                        ++mi;
+                    // as get_subdevices(): no streaming interfaces, no DFU twin
+                    if( alt[6] == 2 || alt[5] == RS2_USB_CLASS_APPLICATION_SPECIFIC )
+                        continue;
+                    usb_device_info info{};
+                    info.id = dev.path;
+                    info.unique_id = dev.path;
+                    info.conn_spec = usb_spec( dd[2] | dd[3] << 8 );
+                    info.vid = uint16_t( dd[8] | dd[9] << 8 );
+                    info.pid = uint16_t( dd[10] | dd[11] << 8 );
+                    info.mi = mi;
+                    info.cls = usb_class( alt[5] );
+                    rv.push_back( info );
+                }
+            }
+            return rv;
+        }
+
+        rs_usb_device usb_broker::create_usb_device( const usb_device_info & info )
+        {
+            std::vector< broker_device_snapshot > devices;
+            auto generation = ensure_session();
+            if( ! generation || ! enumerate( generation, devices ) )
+                return nullptr;
+            for( auto & dev : devices )
+            {
+                if( dev.path != info.id || is_hidden( dev.path ) )
+                    continue;
+                auto msg = broker_message( RSUSB_OP_LEASE );
+                xpc_dictionary_set_uint64( msg.get(), RSUSB_KEY_TOKEN, dev.token );
+                auto reply = call( generation, msg.get(), RSUSB_CALL_TIMEOUT_MS, true );
+                if( reply.result != broker_reply::ok || reply.status != RSUSB_ST_SUCCESS )
+                {
+                    LOG_WARNING( "RealSense USB broker refused device " << info.id << ": " << reply.status );
+                    return nullptr;
+                }
+                auto rv = std::make_shared< usb_device_broker >( shared_from_this(), dev, info, generation );
+                std::lock_guard< std::mutex > lock( _state_mutex );
+                _devices.erase( std::remove_if( _devices.begin(), _devices.end(),
+                                                []( const std::weak_ptr< usb_device_broker > & d ) { return d.expired(); } ),
+                                _devices.end() );
+                _devices.push_back( rv );
+                return rv;
+            }
+            return nullptr;
+        }
+    }
+}
diff --git a/src/libusb/broker/broker-connection.h b/src/libusb/broker/broker-connection.h
new file mode 100644
index 000000000..59a42413f
--- /dev/null
+++ b/src/libusb/broker/broker-connection.h
@@ -0,0 +1,99 @@
+// License: Apache 2.0. See LICENSE file in root directory.
+// Copyright(c) 2026 RealSense, Inc. All Rights Reserved.
+
+#pragma once
+
+#include "broker-wire.h"
+#include "usb/usb-device.h"
+
+#include <dispatch/dispatch.h>
+
+#include <chrono>
+#include <condition_variable>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <shared_mutex>
+#include <string>
+#include <vector>
+
+namespace librealsense
+{
+    namespace platform
+    {
+        class usb_device_broker;
+        class usb_request_broker;
+
+        // Requests by their daemon id, one table per session
+        struct broker_route_table
+        {
+            std::mutex mutex;
+            std::condition_variable idle;   // a request's pin count dropped
+            std::map< uint64_t, usb_request_broker * > routes;
+        };
+
+        struct broker_reply
+        {
+            enum result_t { ok, timeout, failed, invalid };   // failed: stale session or connection error
+            result_t result;
+            xpc_ptr msg;
+            int64_t status;
+        };
+
+        // Connection to the realsense-usbd daemon, chosen once per process by a HELLO; nullptr means in-process libusb
+        class usb_broker : public std::enable_shared_from_this< usb_broker >
+        {
+        public:
+            static std::shared_ptr< usb_broker > instance();
+            // Must be called before the first enumeration
+            static void use_endpoint_for_testing( xpc_endpoint_t endpoint );
+            static void hide_ms_for_testing( uint32_t ms );
+
+            usb_broker();
+            ~usb_broker();
+
+            std::vector< usb_device_info > query_devices_info();
+            rs_usb_device create_usb_device( const usb_device_info & info );
+
+            bool is_current( uint64_t generation ) const;
+            // A missed deadline ends the session when end_on_timeout
+            broker_reply call( uint64_t generation, xpc_object_t msg, uint32_t timeout_ms, bool end_on_timeout );
+            // Fire and forget; a reply, if the op has one, is ignored
+            void send( uint64_t generation, xpc_object_t msg, bool with_reply );
+            std::shared_ptr< broker_route_table > routes( uint64_t generation ) const;
+            void device_lost( uint64_t generation, uint64_t token );
+
+        private:
+            enum hello_result { hello_ok, hello_rejected, hello_unreachable };
+
+            xpc_ptr connect();
+            hello_result hello( xpc_connection_t conn, std::string & reason );
+            uint64_t ensure_session();
+            void end_session( uint64_t generation, bool cancel );
+            void on_event( uint64_t conn_id, xpc_object_t event );
+            bool enumerate( uint64_t generation, std::vector< broker_device_snapshot > & devices );
+            bool is_hidden( const std::string & path );
+
+            dispatch_queue_t _queue;   // connection target queue: events and errors only
+
+            mutable std::shared_timed_mutex _session_mutex;
+            xpc_ptr _conn;
+            uint64_t _conn_id = 0;
+            bool _conn_invalid = false;
+            std::chrono::steady_clock::time_point _conn_created;
+            uint64_t _generation = 0;
+            bool _up = false;
+            std::shared_ptr< broker_route_table > _routes;
+
+            std::mutex _connect_mutex;   // serializes reconnects
+
+            std::mutex _state_mutex;
+            std::vector< std::weak_ptr< usb_device_broker > > _devices;
+            std::map< std::string, std::chrono::steady_clock::time_point > _hidden;
+            std::chrono::steady_clock::time_point _hide_all_until;
+        };
+
+        usb_status broker_status_to_rs( const broker_reply & reply );
+        xpc_ptr broker_message( uint64_t op );
+    }
+}
