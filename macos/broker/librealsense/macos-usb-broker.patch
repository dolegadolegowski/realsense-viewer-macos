@@ -0,0 +1,141 @@
+// License: Apache 2.0. See LICENSE file in root directory.
+// Copyright(c) 2026 RealSense, Inc. All Rights Reserved.
+
+#include "broker-wire.h"
+
+#include <string.h>
+
+namespace librealsense
+{
+    namespace platform
+    {
+        static xpc_object_t get_typed( xpc_object_t dict, const char * key, xpc_type_t type )
+        {
+            if( ! dict || xpc_get_type( dict ) != XPC_TYPE_DICTIONARY )
+                return nullptr;
+            xpc_object_t v = xpc_dictionary_get_value( dict, key );
+            return v && xpc_get_type( v ) == type ? v : nullptr;
+        }
+
+        bool xpc_get_u64( xpc_object_t dict, const char * key, uint64_t & value )
+        {
+            xpc_object_t v = get_typed( dict, key, XPC_TYPE_UINT64 );
+            if( v )
+                value = xpc_uint64_get_value( v );
+            return v != nullptr;
+        }
+
+        bool xpc_get_i64( xpc_object_t dict, const char * key, int64_t & value )
+        {
+            xpc_object_t v = get_typed( dict, key, XPC_TYPE_INT64 );
+            if( v )
+                value = xpc_int64_get_value( v );
+            return v != nullptr;
+        }
+
+        bool xpc_get_data( xpc_object_t dict, const char * key, std::vector< uint8_t > & value )
+        {
+            xpc_object_t v = get_typed( dict, key, XPC_TYPE_DATA );
+            if( ! v )
+                return false;
+            auto p = static_cast< const uint8_t * >( xpc_data_get_bytes_ptr( v ) );
+            size_t n = xpc_data_get_length( v );
+            value.assign( p, p + ( p ? n : 0 ) );
+            return true;
+        }
+
+        bool xpc_get_array( xpc_object_t dict, const char * key, xpc_object_t & value )
+        {
+            value = get_typed( dict, key, XPC_TYPE_ARRAY );
+            return value != nullptr;
+        }
+
+        bool xpc_get_string( xpc_object_t dict, const char * key, std::string & value )
+        {
+            xpc_object_t v = get_typed( dict, key, XPC_TYPE_STRING );
+            if( v )
+                value.assign( xpc_string_get_string_ptr( v ), xpc_string_get_length( v ) );
+            return v != nullptr;
+        }
+
+        bool xpc_get_shmem( xpc_object_t dict, const char * key, xpc_object_t & value )
+        {
+            value = get_typed( dict, key, XPC_TYPE_SHMEM );
+            return value != nullptr;
+        }
+
+        static bool parse_interface( xpc_object_t dict, uint8_t num_configs, broker_interface & intf )
+        {
+            uint64_t cfg;
+            xpc_object_t alts;
+            if( ! xpc_get_u64( dict, RSUSB_KEY_CONFIG, cfg ) || cfg >= num_configs
+                || ! xpc_get_array( dict, RSUSB_KEY_ALTSETTINGS, alts )
+                || ! xpc_get_data( dict, RSUSB_KEY_ENDPOINTS, intf.endpoints ) )
+                return false;
+            size_t n = xpc_array_get_count( alts );
+            if( n < 1 || n > RSUSB_MAX_ALTSETTINGS )
+                return false;
+            intf.config = uint8_t( cfg );
+            intf.alts.resize( n );
+            for( size_t j = 0; j < n; ++j )
+            {
+                auto & alt = intf.alts[j];
+                xpc_object_t a = xpc_array_get_value( alts, j );
+                if( ! xpc_get_data( a, RSUSB_KEY_INTERFACE_DESC, alt.desc ) || alt.desc.size() != RSUSB_INTERFACE_DESC_LEN
+                    || ! xpc_get_data( a, RSUSB_KEY_EXTRA, alt.extra ) || alt.extra.size() > RSUSB_MAX_EXTRA_LEN )
+                    return false;
+            }
+            // altsetting 0's bNumEndpoints must match the endpoint records the interface is built from
+            size_t eps = intf.endpoints.size();
+            return eps % RSUSB_ENDPOINT_WIRE_LEN == 0 && eps / RSUSB_ENDPOINT_WIRE_LEN <= RSUSB_MAX_ENDPOINTS
+                && eps / RSUSB_ENDPOINT_WIRE_LEN == intf.alts[0].desc[4];
+        }
+
+        static bool parse_device( xpc_object_t dict, broker_device_snapshot & dev )
+        {
+            xpc_object_t ifs;
+            if( ! xpc_get_u64( dict, RSUSB_KEY_TOKEN, dev.token ) || ! dev.token
+                || ! xpc_get_string( dict, RSUSB_KEY_PATH, dev.path ) || dev.path.empty()
+                || dev.path.size() > RSUSB_MAX_PATH_LEN || dev.path.find( '\0' ) != std::string::npos
+                || ! xpc_get_data( dict, RSUSB_KEY_DEVICE_DESC, dev.device_desc )
+                || dev.device_desc.size() != RSUSB_DEVICE_DESC_LEN || ! xpc_get_array( dict, RSUSB_KEY_INTERFACES, ifs ) )
+                return false;
+            uint8_t num_configs = dev.device_desc[17];
+            size_t n = xpc_array_get_count( ifs );
+            if( n > size_t( RSUSB_MAX_INTERFACES ) * num_configs )
+                return false;
+            dev.interfaces.resize( n );
+            size_t per_config = 0;
+            for( size_t i = 0; i < n; ++i )
+            {
+                if( ! parse_interface( xpc_array_get_value( ifs, i ), num_configs, dev.interfaces[i] ) )
+                    return false;
+                // configurations are concatenated in index order
+                if( i && dev.interfaces[i].config < dev.interfaces[i - 1].config )
+                    return false;
+                per_config = i && dev.interfaces[i].config == dev.interfaces[i - 1].config ? per_config + 1 : 1;
+                if( per_config > RSUSB_MAX_INTERFACES )
+                    return false;
+            }
+            return true;
+        }
+
+        bool parse_enumerate_reply( xpc_object_t reply, std::vector< broker_device_snapshot > & devices )
+        {
+            int64_t st;
+            xpc_object_t devs;
+            if( ! xpc_get_i64( reply, RSUSB_KEY_STATUS, st ) || st != RSUSB_ST_SUCCESS
+                || ! xpc_get_array( reply, RSUSB_KEY_DEVICES, devs ) )
+                return false;
+            size_t n = xpc_array_get_count( devs );
+            if( n > RSUSB_MAX_DEVICES )
+                return false;
+            std::vector< broker_device_snapshot > rv( n );
+            for( size_t i = 0; i < n; ++i )
+                if( ! parse_device( xpc_array_get_value( devs, i ), rv[i] ) )
+                    return false;
+            devices = std::move( rv );
+            return true;
+        }
+    }
+}
diff --git a/src/libusb/broker/broker-wire.h b/src/libusb/broker/broker-wire.h
new file mode 100644
index 000000000..4410bdb45
--- /dev/null
+++ b/src/libusb/broker/broker-wire.h
@@ -0,0 +1,71 @@
+// License: Apache 2.0. See LICENSE file in root directory.
+// Copyright(c) 2026 RealSense, Inc. All Rights Reserved.
+
+#pragma once
+
+#include "rs-usb-broker-protocol.h"
+
+#include <xpc/xpc.h>
+
+#include <stdint.h>
+#include <string>
+#include <vector>
+
+// XPC helpers and reply validation of the USB broker client. No librealsense dependencies, so the daemon's fuzzer can
+// compile it on its own.
+namespace librealsense
+{
+    namespace platform
+    {
+        class xpc_ptr
+        {
+        public:
+            xpc_ptr() = default;
+            static xpc_ptr adopt( xpc_object_t o ) { xpc_ptr p; p._o = o; return p; }
+            static xpc_ptr retain( xpc_object_t o ) { return adopt( o ? xpc_retain( o ) : nullptr ); }
+            xpc_ptr( const xpc_ptr & other ) : _o( other._o ? xpc_retain( other._o ) : nullptr ) {}
+            xpc_ptr( xpc_ptr && other ) : _o( other._o ) { other._o = nullptr; }
+            xpc_ptr & operator=( xpc_ptr other ) { std::swap( _o, other._o ); return *this; }
+            ~xpc_ptr() { if( _o ) xpc_release( _o ); }
+
+            xpc_object_t get() const { return _o; }
+            xpc_connection_t connection() const { return static_cast< xpc_connection_t >( _o ); }
+            explicit operator bool() const { return _o != nullptr; }
+
+        private:
+            xpc_object_t _o = nullptr;
+        };
+
+        // Typed getters: false for a missing key or a value of another type
+        bool xpc_get_u64( xpc_object_t dict, const char * key, uint64_t & value );
+        bool xpc_get_i64( xpc_object_t dict, const char * key, int64_t & value );
+        bool xpc_get_data( xpc_object_t dict, const char * key, std::vector< uint8_t > & value );
+        bool xpc_get_array( xpc_object_t dict, const char * key, xpc_object_t & value );
+        bool xpc_get_string( xpc_object_t dict, const char * key, std::string & value );
+        bool xpc_get_shmem( xpc_object_t dict, const char * key, xpc_object_t & value );
+
+        struct broker_altsetting
+        {
+            std::vector< uint8_t > desc;   // RSUSB_INTERFACE_DESC_LEN bytes
+            std::vector< uint8_t > extra;
+        };
+
+        struct broker_interface
+        {
+            uint8_t config;
+            std::vector< broker_altsetting > alts;
+            std::vector< uint8_t > endpoints;   // altsetting 0, RSUSB_ENDPOINT_WIRE_LEN bytes each
+        };
+
+        struct broker_device_snapshot
+        {
+            uint64_t token;
+            std::string path;
+            std::vector< uint8_t > device_desc;   // RSUSB_DEVICE_DESC_LEN bytes
+            std::vector< broker_interface > interfaces;
+        };
+
+        // ENUMERATE reply -> snapshots; false if any key, type, length or count violates the protocol header
+        bool parse_enumerate_reply( xpc_object_t reply, std::vector< broker_device_snapshot > & devices );
+    }
+}
diff --git a/src/libusb/broker/device-broker.cpp b/src/libusb/broker/device-broker.cpp
new file mode 100644
index 000000000..7bd6613a8
--- /dev/null
+++ b/src/libusb/broker/device-broker.cpp
@@ -0,0 +1,128 @@
+// License: Apache 2.0. See LICENSE file in root directory.
+// Copyright(c) 2026 RealSense, Inc. All Rights Reserved.
+
+#include "device-broker.h"
+#include "messenger-broker.h"
+#include "../interface-libusb.h"
+
+#include <rsutils/easylogging/easyloggingpp.h>
+
+#include <algorithm>
+#include <cstring>
+
+namespace librealsense
+{
+    namespace platform
+    {
+        // {bLength, bDescriptorType, bLength bytes}; bytes beyond what the wire carries stay zero
+        static usb_descriptor make_descriptor( const uint8_t * p, size_t available )
+        {
+            usb_descriptor ud = { p[0], p[1], std::vector< uint8_t >( p[0] ) };
+            memcpy( ud.data.data(), p, std::min< size_t >( p[0], available ) );
+            return ud;
+        }
+
+        usb_device_broker::usb_device_broker( const std::shared_ptr< usb_broker > & broker,
+                                              const broker_device_snapshot & snapshot, const usb_device_info & info,
+                                              uint64_t generation )
+            : _broker( broker )
+            , _info( info )
+            , _token( snapshot.token )
+            , _generation( generation )
+            , _path( snapshot.path )
+            , _callback_queue( dispatch_queue_create(
+                  "librealsense.usb-broker.device",
+                  dispatch_queue_attr_make_with_qos_class( DISPATCH_QUEUE_SERIAL, QOS_CLASS_USER_INTERACTIVE, 0 ) ) )
+        {
+            _descriptors.push_back( make_descriptor( snapshot.device_desc.data(), snapshot.device_desc.size() ) );
+
+            // Same interfaces, association rule and descriptor order as usb_device_libusb, from libusb structs
+            std::shared_ptr< usb_interface_libusb > curr_ctrl_intf;
+            for( size_t i = 0; i < snapshot.interfaces.size(); ++i )
+            {
+                auto & intf = snapshot.interfaces[i];
+                if( i && intf.config != snapshot.interfaces[i - 1].config )
+                    curr_ctrl_intf.reset();
+
+                std::vector< libusb_endpoint_descriptor > eps( intf.endpoints.size() / RSUSB_ENDPOINT_WIRE_LEN );
+                for( size_t e = 0; e < eps.size(); ++e )
+                {
+                    const uint8_t * p = &intf.endpoints[e * RSUSB_ENDPOINT_WIRE_LEN];
+                    eps[e] = {};
+                    eps[e].bLength = p[0];
+                    eps[e].bDescriptorType = p[1];
+                    eps[e].bEndpointAddress = p[2];
+                    eps[e].bmAttributes = p[3];
+                    eps[e].wMaxPacketSize = uint16_t( p[4] | p[5] << 8 );
+                    eps[e].bInterval = p[6];
+                }
+                std::vector< libusb_interface_descriptor > alts( intf.alts.size() );
+                for( size_t j = 0; j < alts.size(); ++j )
+                {
+                    const uint8_t * d = intf.alts[j].desc.data();
+                    alts[j] = {};
+                    alts[j].bLength = d[0];
+                    alts[j].bDescriptorType = d[1];
+                    alts[j].bInterfaceNumber = d[2];
+                    alts[j].bAlternateSetting = d[3];
+                    alts[j].bNumEndpoints = d[4];
+                    alts[j].bInterfaceClass = d[5];
+                    alts[j].bInterfaceSubClass = d[6];
+                    alts[j].bInterfaceProtocol = d[7];
+                    alts[j].iInterface = d[8];
+                }
+                alts[0].endpoint = eps.data();
+                libusb_interface li = { alts.data(), int( alts.size() ) };
+
+                auto curr_inf = std::make_shared< usb_interface_libusb >( li );
+                _interfaces.push_back( curr_inf );
+                if( alts[0].bInterfaceClass == RS2_USB_CLASS_VIDEO )
+                {
+                    if( alts[0].bInterfaceSubClass == RS2_USB_SUBCLASS_VIDEO_CONTROL )
+                        curr_ctrl_intf = curr_inf;
+                    if( alts[0].bInterfaceSubClass == RS2_USB_SUBCLASS_VIDEO_STREAMING && curr_ctrl_intf )
+                        curr_ctrl_intf->add_associated_interface( curr_inf );
+                }
+
+                for( auto & alt : intf.alts )
+                {
+                    _descriptors.push_back( make_descriptor( alt.desc.data(), alt.desc.size() ) );
+                    auto & x = alt.extra;
+                    for( size_t k = 0; k + 1 < x.size() && x[k] >= 2 && k + x[k] <= x.size(); k += x[k] )
+                        _descriptors.push_back( make_descriptor( &x[k], x[k] ) );
+                }
+            }
+        }
+
+        usb_device_broker::~usb_device_broker()
+        {
+            dispatch_release( _callback_queue );
+        }
+
+        const rs_usb_interface usb_device_broker::get_interface( uint8_t interface_number ) const
+        {
+            auto it = std::find_if( _interfaces.begin(), _interfaces.end(),
+                                    [interface_number]( const rs_usb_interface & i ) { return interface_number == i->get_number(); } );
+            return it == _interfaces.end() ? nullptr : *it;
+        }
+
+        const rs_usb_messenger usb_device_broker::open( uint8_t interface_number )
+        {
+            if( ! alive() || ! get_interface( interface_number ) )
+                return nullptr;
+            auto msg = broker_message( RSUSB_OP_OPEN );
+            xpc_dictionary_set_uint64( msg.get(), RSUSB_KEY_TOKEN, _token );
+            xpc_dictionary_set_uint64( msg.get(), RSUSB_KEY_INTERFACE, interface_number );
+            auto reply = _broker->call( _generation, msg.get(), RSUSB_DEVICE_CALL_TIMEOUT_MS, true );
+            uint64_t h;
+            if( reply.result != broker_reply::ok || reply.status != RSUSB_ST_SUCCESS
+                || ! xpc_get_u64( reply.msg.get(), RSUSB_KEY_HANDLE, h ) || ! h )
+            {
+                LOG_ERROR( "failed to open usb interface: " << (int)interface_number << ", error: "
+                                                            << usb_status_to_string.at( broker_status_to_rs( reply ) ) );
+                return nullptr;
+            }
+            return std::make_shared< usb_messenger_broker >( shared_from_this(), h );
+        }
+    }
+}
diff --git a/src/libusb/broker/device-broker.h b/src/libusb/broker/device-broker.h
new file mode 100644
index 000000000..266ece6e2
--- /dev/null
+++ b/src/libusb/broker/device-broker.h
@@ -0,0 +1,48 @@
+// License: Apache 2.0. See LICENSE file in root directory.
+// Copyright(c) 2026 RealSense, Inc. All Rights Reserved.
+
+#pragma once
+
+#include "broker-connection.h"
+
+#include <atomic>
+
+namespace librealsense
+{
+    namespace platform
+    {
+        // A device leased from the broker; descriptors, interfaces and endpoints are built once from the ENUMERATE snapshot
+        class usb_device_broker : public usb_device, public std::enable_shared_from_this< usb_device_broker >
+        {
+        public:
+            usb_device_broker( const std::shared_ptr< usb_broker > & broker, const broker_device_snapshot & snapshot,
+                               const usb_device_info & info, uint64_t generation );
+            virtual ~usb_device_broker() override;
+
+            virtual const usb_device_info get_info() const override { return _info; }
+            virtual const std::vector< rs_usb_interface > get_interfaces() const override { return _interfaces; }
+            virtual const rs_usb_interface get_interface( uint8_t interface_number ) const override;
+            virtual const rs_usb_messenger open( uint8_t interface_number ) override;
+            virtual const std::vector< usb_descriptor > get_descriptors() const override { return _descriptors; }
+
+            const std::shared_ptr< usb_broker > & get_broker() const { return _broker; }
+            uint64_t get_token() const { return _token; }
+            uint64_t get_generation() const { return _generation; }
+            const std::string & get_path() const { return _path; }
+            dispatch_queue_t callback_queue() const { return _callback_queue; }
+            bool alive() const { return ! _dead && _broker->is_current( _generation ); }
+            void set_dead() { _dead = true; }
+
+        private:
+            const std::shared_ptr< usb_broker > _broker;
+            const usb_device_info _info;
+            const uint64_t _token;
+            const uint64_t _generation;
+            const std::string _path;
+            std::atomic< bool > _dead{ false };
+            dispatch_queue_t _callback_queue;   // request completions, in order
+            std::vector< rs_usb_interface > _interfaces;
+            std::vector< usb_descriptor > _descriptors;
+        };
+    }
+}
diff --git a/src/libusb/broker/messenger-broker.cpp b/src/libusb/broker/messenger-broker.cpp
new file mode 100644
index 000000000..132320428
--- /dev/null
+++ b/src/libusb/broker/messenger-broker.cpp
@@ -0,0 +1,133 @@
+// License: Apache 2.0. See LICENSE file in root directory.
+// Copyright(c) 2026 RealSense, Inc. All Rights Reserved.
+
+#include "messenger-broker.h"
+#include "request-broker.h"
+
+#include <rsutils/easylogging/easyloggingpp.h>
+
+#include <cstring>
+
+namespace librealsense
+{
+    namespace platform
+    {
+        usb_messenger_broker::usb_messenger_broker( const std::shared_ptr< usb_device_broker > & device, uint64_t handle )
+            : _device( device )
+            , _handle( handle )
+        {
+        }
+
+        usb_messenger_broker::~usb_messenger_broker()
+        {
+            auto & broker = _device->get_broker();
+            if( ! broker->is_current( _device->get_generation() ) )
+                return;
+            auto msg = broker_message( RSUSB_OP_CLOSE );
+            xpc_dictionary_set_uint64( msg.get(), RSUSB_KEY_HANDLE, _handle );
+            // A lost device's handle stays in the daemon's table (and quota) until CLOSE; its device queue may be wedged
+            if( _device->alive() )
+                broker->call( _device->get_generation(), msg.get(), RSUSB_DEVICE_CALL_TIMEOUT_MS, true );
+            else
+                broker->send( _device->get_generation(), msg.get(), true );
+        }
+
+        usb_status usb_messenger_broker::transfer( xpc_object_t msg, bool in, uint8_t * buffer, uint32_t length,
+                                                   uint32_t & transferred, uint32_t timeout_ms )
+        {
+            xpc_dictionary_set_uint64( msg, RSUSB_KEY_HANDLE, _handle );
+            xpc_dictionary_set_uint64( msg, RSUSB_KEY_LENGTH, length );
+            xpc_dictionary_set_uint64( msg, RSUSB_KEY_TIMEOUT, timeout_ms );
+            if( ! in && length )
+                xpc_dictionary_set_data( msg, RSUSB_KEY_DATA, buffer, length );
+            // The daemon's own timeout fires first; a missing reply after the margin is a timeout, not a session loss
+            uint32_t clamped = timeout_ms == 0 || timeout_ms > RSUSB_MAX_TIMEOUT_MS ? RSUSB_MAX_TIMEOUT_MS : timeout_ms;
+            auto reply = _device->get_broker()->call( _device->get_generation(), msg, clamped + RSUSB_REPLY_MARGIN_MS, false );
+            if( reply.result != broker_reply::ok || reply.status != RSUSB_ST_SUCCESS )
+                return broker_status_to_rs( reply );
+            uint64_t n;
+            std::vector< uint8_t > data;
+            if( ! xpc_get_u64( reply.msg.get(), RSUSB_KEY_TRANSFERRED, n ) || n > length
+                || ( in && ( ! xpc_get_data( reply.msg.get(), RSUSB_KEY_DATA, data ) || data.size() != n ) ) )
+                return RS2_USB_STATUS_OTHER;
+            if( in && n )
+                memcpy( buffer, data.data(), n );
+            transferred = uint32_t( n );
+            return RS2_USB_STATUS_SUCCESS;
+        }
+
+        usb_status usb_messenger_broker::control_transfer( int request_type, int request, int value, int index, uint8_t * buffer,
+                                                           uint32_t length, uint32_t & transferred, uint32_t timeout_ms )
+        {
+            if( ! _device->alive() )
+                return RS2_USB_STATUS_NO_DEVICE;
+            if( length > RSUSB_MAX_CONTROL_LEN || ( length && ! buffer ) )
+                return RS2_USB_STATUS_INVALID_PARAM;
+            auto msg = broker_message( RSUSB_OP_CONTROL );
+            xpc_dictionary_set_uint64( msg.get(), RSUSB_KEY_REQUEST_TYPE, uint8_t( request_type ) );
+            xpc_dictionary_set_uint64( msg.get(), RSUSB_KEY_REQUEST, uint8_t( request ) );
+            xpc_dictionary_set_uint64( msg.get(), RSUSB_KEY_VALUE, uint16_t( value ) );
+            xpc_dictionary_set_uint64( msg.get(), RSUSB_KEY_INDEX, uint16_t( index ) );
+            auto sts = transfer( msg.get(), request_type & 0x80, buffer, length, transferred, timeout_ms );
+            if( sts != RS2_USB_STATUS_SUCCESS )
+                LOG_WARNING( "control_transfer returned error, index: " << index << ", value: " << value
+                                                                        << ", error: " << usb_status_to_string.at( sts ) );
+            return sts;
+        }
+
+        usb_status usb_messenger_broker::bulk_transfer( const rs_usb_endpoint & endpoint, uint8_t * buffer, uint32_t length,
+                                                        uint32_t & transferred, uint32_t timeout_ms )
+        {
+            if( endpoint->get_type() != RS2_USB_ENDPOINT_BULK && endpoint->get_type() != RS2_USB_ENDPOINT_INTERRUPT )
+            {
+                LOG_ERROR( "Invalid transfer type " << endpoint->get_type() << " on endpoint " << int( endpoint->get_address() ) );
+                return RS2_USB_STATUS_OTHER;
+            }
+            if( ! _device->alive() )
+                return RS2_USB_STATUS_NO_DEVICE;
+            if( length > RSUSB_MAX_BULK_LEN || ( length && ! buffer ) )
+                return RS2_USB_STATUS_INVALID_PARAM;
+            auto msg = broker_message( RSUSB_OP_BULK );
+            xpc_dictionary_set_uint64( msg.get(), RSUSB_KEY_ENDPOINT, endpoint->get_address() );
+            auto sts = transfer( msg.get(), endpoint->get_address() & 0x80, buffer, length, transferred, timeout_ms );
+            if( sts != RS2_USB_STATUS_SUCCESS )
+                LOG_WARNING( "bulk_transfer returned error, endpoint: 0x" << std::hex << int( endpoint->get_address() ) << std::dec
+                                                                         << ", error: " << usb_status_to_string.at( sts ) );
+            return sts;
+        }
+
+        usb_status usb_messenger_broker::reset_endpoint( const rs_usb_endpoint & endpoint, uint32_t /*timeout_ms*/ )
+        {
+            if( ! _device->alive() )
+                return RS2_USB_STATUS_NO_DEVICE;
+            auto msg = broker_message( RSUSB_OP_RESET_EP );
+            xpc_dictionary_set_uint64( msg.get(), RSUSB_KEY_HANDLE, _handle );
+            xpc_dictionary_set_uint64( msg.get(), RSUSB_KEY_ENDPOINT, endpoint->get_address() );
+            auto reply = _device->get_broker()->call( _device->get_generation(), msg.get(), RSUSB_DEVICE_CALL_TIMEOUT_MS, true );
+            auto sts = reply.result == broker_reply::timeout ? RS2_USB_STATUS_NO_DEVICE : broker_status_to_rs( reply );
+            if( sts != RS2_USB_STATUS_SUCCESS )
+                LOG_WARNING( "reset_endpoint returned error, index: " << int( endpoint->get_address() )
+                                                                      << ", error: " << usb_status_to_string.at( sts ) );
+            return sts;
+        }
+
+        rs_usb_request usb_messenger_broker::create_request( rs_usb_endpoint endpoint )
+        {
+            auto rv = std::make_shared< usb_request_broker >( _device, _handle, endpoint );
+            rv->set_shared( rv );
+            return rv;
+        }
+
+        usb_status usb_messenger_broker::submit_request( const rs_usb_request & request )
+        {
+            auto req = std::dynamic_pointer_cast< usb_request_broker >( request );
+            return req ? req->submit() : RS2_USB_STATUS_INVALID_PARAM;
+        }
+
+        usb_status usb_messenger_broker::cancel_request( const rs_usb_request & request )
+        {
+            auto req = std::dynamic_pointer_cast< usb_request_broker >( request );
+            return req ? req->cancel() : RS2_USB_STATUS_INVALID_PARAM;
+        }
+    }
+}
