diff --git a/common/os.cpp b/common/os.cpp
index 26eb5b052..030339dce 100644
--- a/common/os.cpp
+++ b/common/os.cpp
@@ -44,6 +44,44 @@
 
 #include <GLFW/glfw3.h>
 
+#ifdef __APPLE__
+#include <dirent.h>
+#include <mutex>
+
+namespace
+{
+    // Camera access needs root on macOS, so the viewer runs through sudo (or an equivalent launcher). Files saved
+    // through the dialogs are handed back to the invoking user on exit, including any extension or sidecar added
+    // to the chosen name (e.g. ".db3" for recordings).
+    struct sudo_saved_files
+    {
+        std::mutex mutex;
+        std::vector< std::string > paths;
+
+        ~sudo_saved_files()
+        {
+            const char * uid = getenv( "SUDO_UID" );
+            const char * gid = getenv( "SUDO_GID" );
+            if( geteuid() != 0 || ! uid || ! gid )
+                return;
+            for( auto & path : paths )
+            {
+                auto slash = path.find_last_of( '/' );
+                std::string dir = slash == std::string::npos ? "." : path.substr( 0, slash );
+                std::string name = path.substr( slash + 1 );
+                if( DIR * d = opendir( dir.c_str() ) )
+                {
+                    while( dirent * entry = readdir( d ) )
+                        if( std::string( entry->d_name ).compare( 0, name.size(), name ) == 0 )
+                            chown( ( dir + '/' + entry->d_name ).c_str(), (uid_t)atoi( uid ), (gid_t)atoi( gid ) );
+                    closedir( d );
+                }
+            }
+        }
+    } sudo_saved_files_owner;
+}
+#endif
+
 namespace rs2
 {
     // Use shortcuts for long names to avoid trimming of essential data
