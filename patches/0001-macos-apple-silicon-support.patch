+            auto ret = tinyfd_saveFileDialog("Save File", def_ptr, filters_count, aFilterPatterns, aSingleFilterDescription);
+#ifdef __APPLE__
+            if( ret )
+            {
+                std::lock_guard< std::mutex > lock( sudo_saved_files_owner.mutex );
+                sudo_saved_files_owner.paths.push_back( ret );
+            }
+#endif
+            return ret;
         }
