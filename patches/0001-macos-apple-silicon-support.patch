diff --git a/common/os.cpp b/common/os.cpp
index 26eb5b052..44b742041 100644
--- a/common/os.cpp
+++ b/common/os.cpp
@@ -44,8 +44,95 @@
 
 #include <GLFW/glfw3.h>
 
+#ifdef __APPLE__
+#include <dirent.h>
+#include <fcntl.h>
+#include <ctime>
+#include <mutex>
+
+namespace
+{
+    // Camera access needs root on macOS, so the viewer may run as root for the user who started it (through sudo, or
+    // the app's launcher, which sets the same variables)
+    bool get_sudo_user( uid_t & uid, gid_t & gid )
+    {
+        const char * u = getenv( "SUDO_UID" );
+        const char * g = getenv( "SUDO_GID" );
+        if( geteuid() != 0 || ! u || ! g )
+            return false;
+        uid = (uid_t)atoi( u );
+        gid = (gid_t)atoi( g );
+        return true;
+    }
+
+    // Files saved through the dialogs are handed back to that user on exit, including any extension or sidecar added
+    // to the chosen name (e.g. ".db3" for recordings). Only regular files this process created qualify, changed through
+    // descriptors that don't follow links, so nothing planted in the folder can redirect the change.
+    struct sudo_saved_files
+    {
+        std::mutex mutex;
+        std::vector< std::string > paths;
+        time_t const started = time( nullptr );
+
+        ~sudo_saved_files()
+        {
+            uid_t uid;
+            gid_t gid;
+            if( ! get_sudo_user( uid, gid ) )
+                return;
+            for( auto & path : paths )
+            {
+                auto slash = path.find_last_of( '/' );
+                std::string dir = slash == std::string::npos ? "." : path.substr( 0, slash );
+                std::string name = path.substr( slash + 1 );
+                if( DIR * d = opendir( dir.c_str() ) )
+                {
+                    while( dirent * entry = readdir( d ) )
+                    {
+                        if( std::string( entry->d_name ).compare( 0, name.size(), name ) != 0 )
+                            continue;
+                        int fd = openat( dirfd( d ), entry->d_name, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC );
+                        struct stat st;
+                        if( fd >= 0 && fstat( fd, &st ) == 0 && S_ISREG( st.st_mode ) && st.st_uid == 0
+                            && st.st_nlink == 1 && st.st_birthtimespec.tv_sec >= started )
+                            fchown( fd, uid, gid );
+                        if( fd >= 0 )
+                            close( fd );
+                    }
+                    closedir( d );
+                }
+            }
+        }
+    } sudo_saved_files_owner;
+}
+#endif
+
 namespace rs2
 {
+#ifdef __APPLE__
+    std::string open_for_sudo_user( std::string const & path )
+    {
+        uid_t uid;
+        gid_t gid;
+        if( ! get_sudo_user( uid, gid ) )
+            return path;
+        auto slash = path.find_last_of( '/' );
+        int dir = open( slash == std::string::npos ? "." : path.substr( 0, slash ).c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC );
+        struct stat st;
+        int fd = -1;
+        if( dir >= 0 && fstat( dir, &st ) == 0 && st.st_uid == uid )
+            fd = openat( dir, path.c_str() + slash + 1, O_WRONLY | O_APPEND | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0644 );
+        if( dir >= 0 )
+            close( dir );
+        if( fd >= 0 && ( fstat( fd, &st ) != 0 || ! S_ISREG( st.st_mode ) || st.st_nlink != 1 || fchown( fd, uid, gid ) != 0 ) )
+        {
+            close( fd );
+            fd = -1;
+        }
+        return fd < 0 ? std::string() : "/dev/fd/" + std::to_string( fd );  // stays open for whoever opens that path
+    }
+#endif
+
